---
import { portfolioContent } from '../data/portfolioData';
const pt = portfolioContent.pt;
const en = portfolioContent.en;
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-amano-50/85 dark:bg-crystal-950/85 border-b border-amano-200/80 dark:border-crystal-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand / Title -->
    <a href="#title-screen" class="flex items-center gap-2 group">
      <span class="text-amano-cyan dark:text-crystal-blue text-lg font-bold">✦</span>
      <span class="font-ff text-sm sm:text-base tracking-widest font-bold group-hover:text-amano-cyan dark:group-hover:text-crystal-blue transition-colors">
        BRUNO H. F. MELO
      </span>
      <span class="hidden md:inline-block text-xs font-mono text-slate-400 dark:text-slate-500 border-l border-slate-300 dark:border-slate-700 pl-2"
            data-pt="ENGENHARIA DE SOFTWARE P&D"
            data-en="R&D SOFTWARE ENGINEERING">
        ENGENHARIA DE SOFTWARE P&D
      </span>
    </a>

    <!-- Navigation Anchors -->
    <nav class="hidden lg:flex items-center gap-6 font-ff text-xs tracking-wider">
      <a href="#quest-log" class="hover:text-amano-cyan dark:hover:text-crystal-blue transition-colors" data-pt="PROJETOS & CASES" data-en="PROJECTS & CASES">PROJETOS & CASES</a>
      <a href="#status-screen" class="hover:text-amano-cyan dark:hover:text-crystal-blue transition-colors" data-pt="PERFIL & FORMAÇÃO" data-en="PROFILE & EDUCATION">PERFIL & FORMAÇÃO</a>
      <a href="#inventory" class="hover:text-amano-cyan dark:hover:text-crystal-blue transition-colors" data-pt="STACK & HABILIDADES" data-en="STACK & SKILLS">STACK & HABILIDADES</a>
      <a href="#equipment" class="hover:text-amano-cyan dark:hover:text-crystal-blue transition-colors" data-pt="CONTATO & CV" data-en="CONTACT & CV">CONTATO & CV</a>
    </nav>

    <!-- Controls (Sound, Lang, Theme) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Sound FX Toggle -->
      <button 
        id="sound-toggle" 
        class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded border border-amano-300 dark:border-crystal-800 hover:border-amano-cyan dark:hover:border-crystal-blue bg-white/70 dark:bg-crystal-900/70 transition-all cursor-pointer"
        title="Ativar/Desativar efeitos sonoros retrô"
      >
        <svg id="sound-icon" class="w-3.5 h-3.5 text-amano-cyan dark:text-crystal-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <line stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="23" y1="9" x2="17" y2="15"></line>
          <line stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <span id="sound-status" class="text-[10px] sm:text-xs">FX OFF</span>
      </button>

      <!-- Language Selector -->
      <div class="flex items-center rounded border border-amano-300 dark:border-crystal-800 bg-white/70 dark:bg-crystal-900/70 p-0.5 text-[11px] font-mono">
        <button class="lang-toggle-btn px-2 py-0.5 rounded cursor-pointer transition-colors bg-amano-200 dark:bg-crystal-800 font-bold" data-lang="pt">PT</button>
        <button class="lang-toggle-btn px-2 py-0.5 rounded cursor-pointer transition-colors text-slate-500 hover:text-slate-900 dark:hover:text-white" data-lang="en">EN</button>
      </div>

      <!-- Theme Switcher -->
      <button 
        id="theme-toggle" 
        class="p-1.5 rounded border border-amano-300 dark:border-crystal-800 hover:border-amano-cyan dark:hover:border-crystal-blue bg-white/70 dark:bg-crystal-900/70 text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
        title="Alternar Tema (Amano Light / Dark Crystal)"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
